(* 소형 케이스 조립·검사·포장 자동화 공정 설계 *)

PROGRAM main
  VAR
    StartPB : BOOL AT %IX0.0; (* 운전 시작 *)
    StopPB : BOOL AT %IX0.1; (* 운전 정지 *)
    BodyDetected : BOOL AT %IX0.2; (* 본체 투입 감지 *)
    LidDetected : BOOL AT %IX0.3; (* 뚜껑 투입 감지 *)
    BodyAtAssembly : BOOL AT %IX0.4; (* 본체 조립 위치 도착 *)
    LidAtAssembly : BOOL AT %IX0.5; (* 뚜껑 조립 위치 도착 *)
    RobotReady : BOOL AT %IX0.6; (* 로봇 작업 가능 *)
    RobotDone : BOOL AT %IX0.7; (* 로봇 작업 완료 *)
    AssembledDetected : BOOL AT %IX1.0; (* 조립품 배출 감지 *)
    InspectionDetected : BOOL AT %IX1.1; (* 검사 위치 도착 *)
    RejectDetected : BOOL AT %IX1.2; (* 불량품 배출 확인 *)
    PackDetected : BOOL AT %IX1.3; (* 포장 위치 도착 *)
    PackDone : BOOL AT %IX1.4; (* 포장 완료 *)
    FinishedGoodsDetected : BOOL AT %IX1.5; (* 완제품 이동 확인 *)
    ShipmentDetected : BOOL AT %IX1.6;
    SortEye : BOOL AT %IX2.2; (* 불량 분기 위치 감지 *)
    PackDonePulse : BOOL;
    BodyLaunchPulse : BOOL;
    RejectPulse : BOOL;
    ShipPulse : BOOL;
    FeedPermit : BOOL;
    TargetShipped : BOOL;
    LaunchAllowance : UINT;
    LaunchedCount : UINT AT %MW111;
    ShippedCount : UINT AT %MW110;
    M16 : BOOL; (* 조립품 배출 시 한 번만 다음 사이클 허가 *)
    AssemblyJoinedSim : BOOL AT %IX2.4; (* OIP 조립품 결합 완료 *)
    RobotReleasedSignal : BOOL AT %QX2.0; (* OIP 조립 셀에 로봇 완료 전달 *) (* 출고 위치 통과 확인 *)
    BodyConveyorRun : BOOL AT %QX0.0; (* 본체 컨베이어 가동 *)
    LidConveyorRun : BOOL AT %QX0.1; (* 뚜껑 컨베이어 가동 *)
    BodyFeedEnable : BOOL AT %QX0.2; (* 본체 공급 허가 *)
    LidFeedEnable : BOOL AT %QX0.3; (* 뚜껑 공급 허가 *)
    BodyStopper : BOOL AT %QX0.4; (* 본체 정위치 정지 *)
    LidStopper : BOOL AT %QX0.5; (* 뚜껑 정위치 정지 *)
    RobotStart : BOOL AT %QX0.6; (* 로봇 작업 시작 *)
    AssemblyOutRun : BOOL AT %QX0.7; (* 조립품 배출 *)
    InspectionConveyorRun : BOOL AT %QX1.0; (* 검사 컨베이어 가동 *)
    RejectDiverter : BOOL AT %QX1.1; (* 불량품 분기 *)
    PackingConveyorRun : BOOL AT %QX1.2; (* 포장 컨베이어 가동 *)
    PackStart : BOOL AT %QX1.3; (* 포장 작업 시작 *)
    FinishedGoodsConveyorRun : BOOL AT %QX1.4; (* 완제품 이송 *)
    ShippingConveyorRun : BOOL AT %QX1.5; (* 출고 컨베이어 가동 *)
    AlarmLamp : BOOL AT %QX1.6; (* 설비 이상 표시 *)
    WorkOrderActive : UINT AT %MW100; (* 생산지시 활성화 (0/1) *)
    ProductType : UINT AT %MW101; (* 제품 종류 번호 *)
    TargetQuantity : UINT AT %MW102; (* 생산 목표 수량 *)
    MaterialPermit : UINT AT %MW103; (* 자재 공급 허가 (0/1) *)
    ProducedCount : UINT AT %MW104; (* 누적 생산 완료 수량 *)
    RejectCount : UINT AT %MW105; (* 누적 불량 수량 *)
    MachineState : UINT AT %MW106; (* 설비 운전 상태 코드  0 - IDLE : 생산 대기 1 - READY : 운전 준비 완료 2 - RUNNING : 생산 중 3 - MATERIAL_WAIT : 자재 부족 대기 4 - STOPPED : 정상 정지 5 - FAULT : 설비 오류 6 - COMPLETE : 생산 목표 완료 *)
    FaultCode : UINT AT %MW107; (* 오류 원인 코드 *)
    InspectionResultValidWord : UINT AT %MW108; (* 품질 검사 완료 여부(0/1) *)
    InspectionResultValid : BOOL; (* 품질 검사 완료 여부(0/1) => boolean 값으로 변환 *)
    InspectionResultWord : UINT AT %MW109; (* 품질 검사 결과(0/1) *)
    InspectionResult : BOOL; (* 품질 검사 결과(0/1) => boolean 값으로 변환 *)
    WorkOrderActiveOK : BOOL; (* 생산지시 활성화 (0/1) => boolean 값으로 변환 *)
    M0 : BOOL; (* 생산 허가 : 운전 가동 릴레이 : M0 *)
    M1 : BOOL; (* 본체 투입 감지 릴레이 *)
    M2 : BOOL; (* 뚜껑 투입 감지 릴레이 *)
    M3 : BOOL; (* 본체 조립 위치 도착 릴레이 *)
    M4 : BOOL; (* 뚜껑 조립 위치 도착 릴레이 *)
    M5 : BOOL; (* 로봇 작업 가능 릴레이 *)
    M6 : BOOL; (* 로봇 작업 완료 릴레이 *)
    M7 : BOOL; (* 조립품 배출 감지 릴레이 *)
    M8 : BOOL; (* 검사 위치 도착 릴레이 *)
    M9 : BOOL; (* 품질 검사 완료 릴레이 *)
    M10 : BOOL; (* 품질 검사 결과가 불량품일 경우 불량품 배출 감지 릴레이 *)
    M11 : BOOL; (* 품질 검사 결과가 온품인 릴레이 *)
    M12 : BOOL; (* 포장 위치 도착 릴레이 *)
    M13 : BOOL; (* 포장 완료 릴레이 *)
    M14 : BOOL; (* 완제품 이송 감지 릴레이 *)
    M15 : BOOL; (* 출고 위치 통과 감지 릴레이 *)
  END_VAR

