diff --git a/src/editor/caseflow/bridge.ts b/src/editor/caseflow/bridge.ts
new file mode 100644
index 0000000..af7a101
--- /dev/null
+++ b/src/editor/caseflow/bridge.ts
@@ -0,0 +1,204 @@
+// CaseFlow twin bridge (this fork's only addition to the simulator).
+//
+// With ?scene=caseflow the editor boots straight into the CaseFlow case-assembly line (public/caseflow/caseflow.oip),
+// starts the simulation, and publishes `window.caseflow`: a small API the CaseFlow MES page (same origin, the twin
+// sits in an <iframe>) uses to read PLC tags and to act on the line the way a person on the shop floor would -
+// the field start/stop buttons and the robot's teach pendant. The MES itself only grants a permit (MesPermit);
+// the line runs only after a start button is pressed (plc/program.st).
+import type { EditorStore } from '../store/store'
+import type { SimClient } from '../../sim/client'
+import type { PartInstance, SceneJSON } from '../../core/types'
+
+type Controller = {
+  run(): void
+  stop(): void
+  writePlcValue(key: string, text: string): string | null
+  forcePlcValue(key: string, text?: string): string | null
+  releasePlcForces(key?: string): void
+  previewRigPose(partId: string, row: readonly number[]): void
+}
+type CameraPose = { px: number; py: number; pz: number; tx: number; ty: number; tz: number }
+type Hook = { controller?: Controller; view?: { setCameraPose(p: CameraPose, o?: { instant?: boolean }): void } }
+
+/** camera presets for the MES page: the whole line, and the assembly robot up close */
+export const VIEWS: Record<string, CameraPose> = {
+  overview: { px: 9, py: 12.5, pz: 18, tx: 11.7, ty: 0.4, tz: 1.2 },
+  robot: { px: 5.6, py: 3.2, pz: 4.4, tx: 3.2, ty: 0.9, tz: 0.6 },
+  shipping: { px: 24, py: 5, pz: 7, tx: 21, ty: 0.8, tz: 0 },
+}
+
+export const ROBOT_ID = 'AssemblyRobot'
+/** waypoint row the pendant's jog moves use, and the job that moves there (appended after the production jobs) */
+const JOG_NAME = 'JOG'
+/** joint limits in degrees: Neuromeka Indy7 (indy7.urdf, ±175° for J1-J5, ±215° for J6) */
+export const JOINT_LIMITS: [number, number][] = [[-175, 175], [-175, 175], [-175, 175], [-175, 175], [-175, 175], [-215, 215]]
+
+const sleep = (ms: number): Promise<void> => new Promise((r) => setTimeout(r, ms))
+const clampRow = (row: readonly number[]): number[] =>
+  row.slice(0, 6).map((v, i) => {
+    const [lo, hi] = JOINT_LIMITS[i] ?? [-180, 180]
+    return Math.min(hi, Math.max(lo, Math.round(Number(v) * 100) / 100))
+  })
+
+export function isCaseflowBoot(): boolean {
+  return new URLSearchParams(location.search).get('scene') === 'caseflow'
+}
+
+export async function fetchCaseflowArchive(): Promise<Uint8Array | null> {
+  try {
+    const res = await fetch('/caseflow/caseflow.oip', { cache: 'no-cache' })
+    return res.ok ? new Uint8Array(await res.arrayBuffer()) : null
+  } catch {
+    return null
+  }
+}
+
+export function installCaseflowBridge(store: EditorStore, sim: SimClient): void {
+  const w = window as unknown as { __oip?: Hook; caseflow?: unknown }
+  const ctrl = (): Controller | null => w.__oip?.controller ?? null
+  const robot = (): PartInstance | undefined => store.getState().scene.parts.find((p) => p.id === ROBOT_ID)
+  const tags = (): Record<string, unknown> => ({ ...(sim.plcState?.watch ?? {}) })
+  const lineRunning = (): boolean => tags().M0 === true
+  let busy = false
+
+  /** Replace the robot's params as one authoring edit (an undo step, and the run picks it up live). */
+  const setRobotParams = (patch: Record<string, unknown>, label: string): void => {
+    const scene = store.getState().scene
+    const next: SceneJSON = { ...scene, parts: scene.parts.map((p) => (p.id === ROBOT_ID ? ({ ...p, params: { ...p.params, ...patch } } as PartInstance) : p)) }
+    store.commit(label, next)
+  }
+  const program = (): { waypoints: number[][]; names: string[]; jobs: number[][]; jobNames: string[] } => {
+    const p = (robot()?.params ?? {}) as Record<string, unknown>
+    return {
+      waypoints: ((p.waypoints as number[][]) ?? []).map((r) => [...r]),
+      names: String(p.waypointNames ?? '').split('\n'),
+      jobs: ((p.jobs as number[][]) ?? []).map((r) => [...r]),
+      jobNames: String(p.jobNames ?? '').split('\n'),
+    }
+  }
+  /** Ensure the JOG waypoint and a one-step job moving to it exist; returns the job number (1-based). */
+  const ensureJogJob = (row: number[]): number => {
+    const pr = program()
+    let wi = pr.names.indexOf(JOG_NAME)
+    if (wi < 0) {
+      wi = pr.waypoints.length
+      pr.waypoints.push(row)
+      pr.names[wi] = JOG_NAME
+    } else pr.waypoints[wi] = row
+    let ji = pr.jobNames.indexOf('Jog')
+    const jobCount = Math.max(0, ...pr.jobs.map((r) => (r[0] ?? 0) + 1))
+    if (ji < 0) {
+      ji = jobCount
+      pr.jobNames[ji] = 'Jog'
+      pr.jobs.push([ji, 1, wi, 0])
+    }
+    setRobotParams({ waypoints: pr.waypoints, waypointNames: pr.names.join('\n'), jobs: pr.jobs, jobNames: pr.jobNames.join('\n') }, 'Teach pendant jog')
+    return ji + 1
+  }
+  /** Run one robot job outside production: hold the PLC's robot command, raise Execute, wait for Done. */
+  const runJob = async (job: number, timeoutMs = 20000): Promise<string | null> => {
+    const c = ctrl()
+    if (!c) return '시뮬레이터 준비 중입니다.'
+    if (lineRunning()) return '공정 가동 중에는 수동 조작이 잠깁니다. 현장 정지 후 사용하세요.'
+    busy = true
+    try {
+      // a robot still finishing its last job drops a new Execute edge, as a real controller does: wait for Done
+      const w0 = performance.now()
+      while (tags().RobotReady !== true) {
+        if (performance.now() - w0 > timeoutMs) return '로봇이 이전 동작을 마치지 못했습니다. 잠시 후 다시 시도하세요.'
+        await sleep(100)
+      }
+      c.forcePlcValue('RobotCommand', String(job))
+      c.forcePlcValue('RobotStart', 'FALSE')
+      await sleep(150)
+      c.forcePlcValue('RobotStart', 'TRUE')
+      const t0 = performance.now()
+      let started = false
+      while (performance.now() - t0 < timeoutMs) {
+        const ready = tags().RobotReady === true
+        if (!ready) started = true
+        else if (started || performance.now() - t0 > 1500) break
+        await sleep(50)
+      }
+      return null
+    } finally {
+      c.releasePlcForces('RobotStart')
+      c.releasePlcForces('RobotCommand')
+      busy = false
+    }
+  }
+
+  const api = {
+    ready: false,
+    tags,
+    lineRunning,
+    busy: () => busy,
+    /** stop and restart the simulation: counters, latches and cargo clear (a new work order starts clean) */
+    reset: async (): Promise<void> => {
+      const c = ctrl()
+      if (!c) return
+      c.stop()
+      await sleep(600)
+      c.run()
+    },
+    view: (name: string, instant = false): void => {
+      const pose = VIEWS[name]
+      if (pose) w.__oip?.view?.setCameraPose(pose, { instant })
+    },
+    /** BOOL/INT write of a program input (MesPermit, HmiStart, ...), as an operator panel would */
+    write: (key: string, value: boolean | number): string | null => ctrl()?.writePlcValue(key, String(value).toUpperCase()) ?? 'not ready',
+    /** a momentary press of an HMI button tag */
+    press: async (key: 'HmiStart' | 'HmiStop'): Promise<void> => {
+      ctrl()?.writePlcValue(key, 'TRUE')
+      await sleep(300)
+      ctrl()?.writePlcValue(key, 'FALSE')
+    },
+    robot: {
+      limits: JOINT_LIMITS,
+      /** current joint angles in degrees, from the latest sim frame (null before the first frame) */
+      joints(): number[] | null {
+        const rec = (sim as unknown as { frameWire?: { records?: { joints?: Record<string, Record<string, number>> } } }).frameWire?.records?.joints?.[ROBOT_ID]
+        if (!rec) return null
+        // joint names come from the robot's rig: joint0..joint5 on the imported Indy7, j1..j6 on OIP's own six-axis arm
+        const names = 'joint0' in rec ? ['joint0', 'joint1', 'joint2', 'joint3', 'joint4', 'joint5'] : ['j1', 'j2', 'j3', 'j4', 'j5', 'j6']
+        return names.map((j) => Math.round(((rec[j] ?? 0) * 180) / Math.PI * 100) / 100)
+      },
+      program,
+      /** move the arm to a joint row (degrees) as a jog: limited to the joint ranges, refused while the line runs */
+      jogTo: async (row: number[]): Promise<string | null> => {
+        if (lineRunning()) return '공정 가동 중에는 수동 조작이 잠깁니다.'
+        const job = ensureJogJob(clampRow(row))
+        await sleep(120)
+        return runJob(job)
+      },
+      runJob,
+      /** write the taught waypoints and the production job back into the line (what the PLC runs from now on) */
+      apply: (p: { waypoints: number[][]; names: string[]; steps: number[][] }): string | null => {
+        if (lineRunning()) return '공정 가동 중에는 프로그램을 바꿀 수 없습니다.'
+        const cur = program()
+        const jogJobs = cur.jobs.filter((r) => r[0] !== 0)
+        setRobotParams(
+          {
+            waypoints: p.waypoints.map(clampRow),
+            waypointNames: p.names.join('\n'),
+            jobs: [...p.steps.map((s) => [0, s[1], s[2], s[3] ?? 0]), ...jogJobs],
+          },
+          'Teach pendant: apply program',
+        )
+        return null
+      },
+    },
+  }
+  w.caseflow = api
+
+  // Play as soon as the editor's controller is up: the twin is a running line, not a document being edited.
+  const started = setInterval(() => {
+    const c = ctrl()
+    if (!c) return
+    clearInterval(started)
+    if (!store.getState().running) c.run()
+    api.ready = true
+    setTimeout(() => api.view('overview', true), 800)
+    window.parent?.postMessage({ type: 'caseflow:ready' }, location.origin)
+  }, 300)
+}
